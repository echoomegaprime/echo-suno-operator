PORT=8788
VAULT_MASTER_KEY=
# Clerk / consumer Suno (not Platform API)
SUNO_AUTH_BASE=https://auth.suno.com
SUNO_STUDIO_API=https://studio-api-prod.suno.com
# Optional bootstrap cookie if you refuse the local paste UI
SUNO_COOKIE=
# Required on the HTTP MCP backend; shared only with the OAuth connector.
SUNO_PROXY_TOKEN=
# Optional studio token. When set, all private /v1 account and library routes require it.
SUNO_UI_TOKEN=
